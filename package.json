{
  "name": "glory-management",
  "version": "1.0.0",
  "description": "Glory Management - Boxing management simulation game",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:clean": "rm -rf .next && npm run dev",
    "dev:reset": "rm -rf .next node_modules/.cache && npm install && npm run dev",
    "build:clean": "rm -rf .next && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:generate": "supabase gen types typescript --local > src/types/database.types.ts",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase db push"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.0",
    "@sentry/nextjs": "^10.0.0",
    "@supabase/auth-helpers-nextjs": "^0.8.0",
    "@supabase/supabase-js": "^2.38.0",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.0",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.292.0",
    "next": "^14.0.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.47.0",
    "react-hot-toast": "^2.4.0",
    "recharts": "^2.8.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.9.2",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "eslint": "^8.51.0",
    "eslint-config-next": "^14.0.0"
  },
  "keywords": [
    "boxing",
    "management",
    "game",
    "fighter",
    "promoter",
    "simulation"
  ],
  "author": "Glory Boxing Team",
  "license": "MIT"
}
